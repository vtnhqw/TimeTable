{
  "name": "timetable-wallpaper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --experimental-strip-types tests/run-tests.mjs && node --experimental-strip-types tests/regressions.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write app components lib tests *.json *.ts *.mjs",
    "format:check": "prettier --check app components lib tests *.json *.ts *.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
